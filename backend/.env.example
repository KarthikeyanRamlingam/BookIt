DATABASE_URL="postgresql://postgres:postgres@localhost:5433/appointment_platform"
DIRECT_URL="postgresql://postgres:postgres@localhost:5433/appointment_platform"
JWT_SECRET="change_this_to_a_long_random_string"
JWT_EXPIRES_IN="7d"
COOKIE_SAME_SITE="lax"
COOKIE_MAX_AGE_MS=604800000
PORT=4000
RUN_SCHEDULED_JOBS="true"
FRONTEND_URL="http://localhost:3000"
# Comma-separated production and local origins, if more than one is needed.
FRONTEND_URLS="http://localhost:3000"
BACKEND_URL="http://localhost:4000"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-this-admin-password"

# Web Push (generate once with: npx web-push generate-vapid-keys)
VAPID_SUBJECT="mailto:support@bookit.app"
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# Email (Nodemailer / SMTP, e.g. Mailtrap, Gmail app password, or SES SMTP)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Appointment Platform <no-reply@example.com>"

# Payments
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
CRON_SECRET="replace-with-a-long-random-secret"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# SMS / WhatsApp (Twilio example)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_SMS_FROM=""
TWILIO_WHATSAPP_FROM=""
